# Copy this file to .env and adjust if you need to. Every value below has a
# working default, so the game runs without a .env file at all.

# Port the server listens on.
PORT=3000

# libSQL connection string. A local file is created by "npm run db".
DATABASE_URL=file:local.db

NODE_ENV=development

# Secret used to sign login tokens. Anyone who knows it can mint a token for any
# account, so use your own value and never commit it. Without one the server
# falls back to a development secret and warns on startup.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts before the player has to sign in again.
JWT_EXPIRES_IN=2h
